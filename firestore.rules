rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── USER DATA ───────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can READ profiles (needed for global rankings)
      allow read: if request.auth != null;

      // CREATE: Only own document, prevent spoofing isAdmin
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);

      // UPDATE: Only own document with basic anti-cheat guards
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin'])
        // CRITICAL: Prevent users from making themselves premium.
        // Only Cloud Functions (verifyPayment) run as admin and can bypass this.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'premiumExpiryDate'])
          || request.resource.data.isPremium == false // Client can only revoke/reset, not grant
        )
        // Sanity checks for progression (prevent jumping to 1M XP instantly)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalExp'])
          || (request.resource.data.totalExp <= resource.data.totalExp + 2000 
              && request.resource.data.totalExp >= resource.data.totalExp)
        )
        // MONEY SECURITY: Prevent adding huge amounts of coins from the client
        // Normal game rewards are 10-50. Buying a key subtracts 150.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins'])
          || (request.resource.data.coins <= resource.data.coins + 250) // Max 250 earned at once
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kidsCoins'])
          || (request.resource.data.kidsCoins <= resource.data.kidsCoins + 250) // Max 250 earned at once
        )
        // ANTI-SPAM: Enforce a strict 2-second rate limit on ANY rewards (XP or Coins)
        // This prevents hackers from bypassing the max-per-write limits by sending 100 writes/sec.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalExp', 'coins', 'kidsCoins'])
          || (
            // Bypass rate limit if it's a purchase/penalty (values are decreasing or staying the same)
            (
              request.resource.data.get('totalExp', 0) <= resource.data.get('totalExp', 0) &&
              request.resource.data.get('coins', 0) <= resource.data.get('coins', 0) &&
              request.resource.data.get('kidsCoins', 0) <= resource.data.get('kidsCoins', 0)
            )
            // If they increased, enforce the timestamp cooldown
            || (
              request.resource.data.lastRewardTimestamp == request.time &&
              (
                !('lastRewardTimestamp' in resource.data) || 
                resource.data.lastRewardTimestamp == null ||
                request.time >= resource.data.lastRewardTimestamp + duration.value(2, 's')
              )
            )
          )
        )
        // KEY SECURITY: Prevent granting oneself infinite keys
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['goldenKeys'])
          || (request.resource.data.goldenKeys <= resource.data.goldenKeys + 1) // Can only gain 1 at a time (ads/store)
        );

      // DELETE: Only own document
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ─── GLOBAL METADATA ─────────────────────────────────────────────
    match /metadata/leaderboard_cache {
      // Allow all users to read the pre-calculated rankings (1 Read instead of 50)
      allow read: if request.auth != null;
      
      // SECURITY: Only Cloud Functions (admin SDK) can write leaderboard data.
      // Prevents users from injecting fake rankings via direct Firestore writes.
      allow write: if false;
    }

    match /metadata/kids_leaderboard_cache {
      // Allow all users to read the pre-calculated kids rankings
      allow read: if request.auth != null;
      
      // SECURITY: Only Cloud Functions (admin SDK) can write leaderboard data.
      allow write: if false;
    }

    // ─── RATE LIMITING (Server-Side Only) ─────────────────────────────
    // Used by Cloud Functions for per-user payment rate limiting.
    // Clients must never read or write rate limit documents directly.
    match /rate_limits/{document=**} {
      allow read, write: if false;
    }

    // ─── CURRICULUM & QUEST DATA ─────────────────────────────────────
    match /coinPacks/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /speaking_quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /reading_quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /grammar_quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /kids_quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /curriculum/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /vocabulary_quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /roleplay_quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /listening_quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /accent_quests/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ─── SUBSCRIPTION PLANS ──────────────────────────────────
    match /subscriptionPlans/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ─── LEGACY / OTHER ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
