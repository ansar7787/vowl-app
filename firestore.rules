rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches request.auth.uid)
    // Fields:
    //   - id: string (required) - Firebase Auth UID
    //   - email: string (required) - user's email address
    //   - displayName: string (optional) - user's display name
    //   - photoUrl: string (optional) - URL to profile avatar
    //   - fcmToken: string (optional) - FCM device registration token
    //   - coins: int (optional, default 0) - standard coin balance
    //   - totalExp: int (optional, default 0) - lifetime experience points
    //   - isAdmin: bool (optional, default false) - admin privileges flag
    //   - isPremium: bool (optional, default false) - VIP subscription status
    //   - premiumExpiryDate: timestamp (optional) - VIP expiration date
    //   - currentStreak: int (optional, default 0) - daily login streak
    //   - lastLoginDate: timestamp (optional) - timestamp of last login
    //   - isEmailVerified: bool (optional, default false) - email verification flag
    //   - categoryStats: map (optional) - category progress percentages
    //   - unlockedLevels: map (optional) - map of unlocked level indices
    //   - completedLevels: map (optional) - map of completed level lists
    //   - starRatings: map (optional) - map of star ratings per level
    //   - badges: list (optional) - list of badge IDs
    //   - streakFreezes: int (optional) - count of streak freeze tokens
    //   - hintCount: int (optional) - hint balance
    //   - hintPacks: int (optional) - hint pack balance
    //   - doubleXP: int (optional) - double XP balance
    //   - doubleXPExpiry: timestamp (optional) - active double XP expiration
    //   - dailyXpHistory: map (optional) - daily XP history
    //   - recentActivities: list (optional) - list of recent activity entries
    //   - lastVipGiftDate: timestamp (optional) - last claimed VIP gift
    //   - lastDailyRewardDate: timestamp (optional) - last claimed daily reward
    //   - lastKidsDailyRewardDate: timestamp (optional) - last claimed kids reward
    //   - kidsCoins: int (optional, default 0) - kids coin balance
    //   - kidsStickers: list (optional) - unlocked sticker IDs
    //   - kidsMascot: string (optional) - equipped mascot
    //   - kidsEquippedSticker: string (optional) - equipped sticker
    //   - kidsOwnedAccessories: list (optional) - owned accessory IDs
    //   - kidsEquippedAccessory: string (optional) - equipped accessory
    //   - vowlMascot: string (optional) - adult mascot ID
    //   - vowlEquippedAccessory: string (optional) - adult equipped accessory
    //   - vowlOwnedAccessories: list (optional) - adult owned accessory IDs
    //   - vowlOwnedMascots: list (optional) - adult owned mascot IDs
    //   - claimedStreakMilestones: list (optional) - claimed streak milestones
    //   - claimedLevelMilestones: list (optional) - claimed level milestones
    //   - coinHistory: list (optional) - ledger of coin adjustments
    //   - hasPermanentXPBoost: bool (optional) - permanent boost flag
    //   - kidsOwnedFurniture: list (optional) - owned furniture IDs
    //   - kidsEquippedFurniture: map (optional) - equipped furniture map
    //   - keys / goldenKeys: int (optional, default 0) - keys count
    //   - lastRewardTimestamp: timestamp (optional) - rate limit timestamp
    //   - referralCode: string (optional, 6-16 chars) - user's own viral referral code
    //   - referredBy: string (optional, 6-16 chars) - code of the ambassador who referred user
    //   - pendingReferralCode: string (optional, <= 30 chars or null) - pending referral pass saved before Adventure Level 1
    //   - hasClaimedReferral: bool (optional, default false) - referral welcome bonus claimed flag
    //   - totalReferralsCount: int (optional, default 0) - lifetime successful referral conversions
    //   - monthlyReferralsCount: int (optional, default 0) - active month referral count
    //   - currentReferralMonthKey: string (optional, e.g. '2026-11') - ambassador tracking month
    //   - claimedAmbassadorRewardMonthKeys: list (optional) - list of claimed month keys
    //   - claimedWeeklyRewardWeekKeys: list (optional) - list of claimed week keys
    //   - dailyDuelsPlayedToday: int (optional, default 0) - 1v1 staking duels played today
    //   - lastDuelDate: timestamp (optional) - timestamp of last 1v1 staking duel played
    //   - duelWins: int (optional, default 0) - lifetime 1v1 staking duel victories
    //   - duelLosses: int (optional, default 0) - lifetime 1v1 staking duel defeats
    //
    // Subcollection: users/{userId}/errorJournal/{errorId}
    // Fields:
    //   - gameType: string (< 100 chars)
    //   - question: string (< 1000 chars)
    //   - userAnswer: string (< 1000 chars)
    //   - correctAnswer: string (< 1000 chars)
    //   - level: dynamic
    //   - options: list (< 20 items)
    //   - timestamp: timestamp (server timestamp required)
    //
    // Collection: referrals/{referralCode}
    // Document ID: {referralCode} (e.g. 'VOWL-7K9A', uppercase alphanumeric with hyphens, 6-16 chars)
    // Fields:
    //   - code: string (required, 6-16 chars) - referral code matching doc id
    //   - ownerId: string (required) - Firebase Auth UID of code owner
    //   - ownerName: string (required, <= 100 chars) - ambassador display name
    //   - ownerPhotoUrl: string (optional, <= 1000 chars) - ambassador photo URL
    //   - createdAt: timestamp (required) - creation timestamp
    //   - successfulCount: int (required, default 0) - total friends completed level 1
    //   - monthlyCount: int (required, default 0) - monthly friends completed level 1
    //   - currentMonthKey: string (required, e.g. '2026-11') - active ambassador cup month
    //   - lastReferralTimestamp: timestamp (optional) - last friend conversion timestamp
    //
    // Collection: arena_rooms/{roomCode}
    // Document ID: {roomCode} (e.g. 'VOWL-DUEL-882', uppercase alphanumeric with hyphens, 6-20 chars)
    // Fields:
    //   - roomCode / code: string (optional, <= 20 chars)
    //   - hostId: string (required) - host user UID
    //   - hostName: string (optional, <= 100 chars)
    //   - hostPhotoUrl: string (optional, <= 1000 chars)
    //   - guestId: string (optional) - guest user UID
    //   - guestName: string (optional, <= 100 chars)
    //   - guestPhotoUrl: string (optional, <= 1000 chars)
    //   - stake: int (required, must be 30) - 1v1 staking entry fee
    //   - pot: int (optional, 60) - total coins staked in duel
    //   - status: string (optional, <= 30 chars, e.g. 'waiting', 'active', 'completed', 'cancelled')
    //   - createdAt: timestamp (required) - room creation timestamp
    //   - updatedAt: timestamp (optional)
    //   - lastHeartbeat: timestamp (optional) - live duel heartbeat
    //   - hostScore: int (optional)
    //   - guestScore: int (optional)
    //   - hostFinished: bool (optional)
    //   - guestFinished: bool (optional)
    //   - winnerId: string (optional)
    //   - questions: list (optional, <= 20 items)
    //
    // Collection: arena_queue/{queueId}
    // Document ID: {queueId} (e.g. unique ticket ID or user UID)
    // Fields:
    //   - userId: string (required) - Firebase Auth UID of queued player
    //   - displayName: string (optional, <= 100 chars) - challenger display name
    //   - photoUrl: string (optional, <= 1000 chars) - challenger photo URL
    //   - roomCode: string (optional, <= 30 chars) - reserved room code for matchmaking
    //   - createdAt: timestamp (required) - server timestamp of queue entry
    //
    // Collection: metadata/{cacheDoc}
    //   - leaderboard_cache / kids_leaderboard_cache: precomputed top users
    //
    // Collection: orders/{orderId}
    //   - userId: string (matches buyer's auth uid)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Base expiration timestamp for calculating VIP extensions
    function baseExpiryTime() {
      return ('premiumExpiryDate' in resource.data) && (resource.data.premiumExpiryDate is timestamp) && resource.data.premiumExpiryDate > request.time
        ? resource.data.premiumExpiryDate
        : request.time;
    }

    // Validates legitimate in-app VIP reward claims (Referral trial, Weekly reward, Ambassador Cup, Ambassador Referral Reward)
    function isLegitimatePremiumRewardClaim() {
      return request.resource.data.get('premiumExpiryDate', null) is timestamp
        && request.resource.data.premiumExpiryDate >= request.time
        && (
          // 1. Referral Onboarding Bonus: 1-Day VIP Trial (max 2 days buffer)
          (
            resource.data.get('hasClaimedReferral', false) == false
            && request.resource.data.get('hasClaimedReferral', false) == true
            && request.resource.data.premiumExpiryDate <= baseExpiryTime() + duration.value(2, 'd')
          )
          // 2. Sunday Weekly Leaderboard Reward: max 7 days extension (8 days buffer)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimedWeeklyRewardWeekKeys'])
            && request.resource.data.get('claimedWeeklyRewardWeekKeys', []) is list
            && request.resource.data.get('claimedWeeklyRewardWeekKeys', []).size() == resource.data.get('claimedWeeklyRewardWeekKeys', []).size() + 1
            && request.resource.data.premiumExpiryDate <= baseExpiryTime() + duration.value(8, 'd')
          )
          // 3. Monthly Ambassador Cup Reward: max 31 days extension (32 days buffer)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimedAmbassadorRewardMonthKeys'])
            && request.resource.data.get('claimedAmbassadorRewardMonthKeys', []) is list
            && request.resource.data.get('claimedAmbassadorRewardMonthKeys', []).size() == resource.data.get('claimedAmbassadorRewardMonthKeys', []).size() + 1
            && request.resource.data.premiumExpiryDate <= baseExpiryTime() + duration.value(32, 'd')
          )
          // 4. Ambassador Referral Reward: 1 Day VIP per new referral conversion (max 2 days buffer per referral)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalReferralsCount'])
            && request.resource.data.get('totalReferralsCount', 0) > resource.data.get('totalReferralsCount', 0)
            && request.resource.data.premiumExpiryDate <= baseExpiryTime() + duration.value(2, 'd') * (request.resource.data.get('totalReferralsCount', 0) - resource.data.get('totalReferralsCount', 0))
          )
        );
    }

    // Validates referral document schema and bounds
    function isValidReferralData(data) {
      return data.keys().hasOnly(['code', 'ownerId', 'ownerName', 'ownerPhotoUrl', 'createdAt', 'successfulCount', 'monthlyCount', 'currentMonthKey', 'lastReferralTimestamp'])
        && data.code is string && data.code.size() >= 6 && data.code.size() <= 16
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.ownerName is string && data.ownerName.size() <= 100
        && (!('ownerPhotoUrl' in data) || data.ownerPhotoUrl == null || (data.ownerPhotoUrl is string && data.ownerPhotoUrl.size() <= 1000))
        && data.createdAt is timestamp
        && data.successfulCount is int && data.successfulCount >= 0
        && data.monthlyCount is int && data.monthlyCount >= 0
        && data.currentMonthKey is string && data.currentMonthKey.size() <= 10
        && (!('lastReferralTimestamp' in data) || data.lastReferralTimestamp == null || data.lastReferralTimestamp is timestamp);
    }

    // Validates 1v1 PvP Arena Room schema and bounds
    function isValidArenaRoom(data) {
      return data.hostId is string && data.hostId.size() > 0 && data.hostId.size() <= 128
        && data.stake is int && data.stake == 30
        && (!('pot' in data) || (data.pot is int && data.pot == 60))
        && data.createdAt is timestamp
        && (!('code' in data) || (data.code is string && data.code.size() <= 20))
        && (!('roomCode' in data) || (data.roomCode is string && data.roomCode.size() <= 20))
        && (!('hostName' in data) || data.hostName == null || (data.hostName is string && data.hostName.size() <= 100))
        && (!('hostPhotoUrl' in data) || data.hostPhotoUrl == null || (data.hostPhotoUrl is string && data.hostPhotoUrl.size() <= 1000))
        && (!('guestId' in data) || data.guestId == null || (data.guestId is string && data.guestId.size() <= 128))
        && (!('guestName' in data) || data.guestName == null || (data.guestName is string && data.guestName.size() <= 100))
        && (!('guestPhotoUrl' in data) || data.guestPhotoUrl == null || (data.guestPhotoUrl is string && data.guestPhotoUrl.size() <= 1000))
        && (!('status' in data) || (data.status is string && data.status.size() <= 30))
        && (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp)
        && (!('lastHeartbeat' in data) || data.lastHeartbeat == null || data.lastHeartbeat is timestamp)
        && (!('hostScore' in data) || (data.hostScore is int && data.hostScore >= 0 && data.hostScore <= 1000))
        && (!('guestScore' in data) || (data.guestScore is int && data.guestScore >= 0 && data.guestScore <= 1000))
        && (!('hostFinished' in data) || data.hostFinished is bool)
        && (!('guestFinished' in data) || data.guestFinished is bool)
        && (!('winnerId' in data) || data.winnerId == null || (data.winnerId is string && data.winnerId.size() <= 128))
        && (!('questions' in data) || (data.questions is list && data.questions.size() <= 20))
        && (!('hostReady' in data) || data.hostReady is bool)
        && (!('guestReady' in data) || data.guestReady is bool);
    }

    // Validates 1v1 PvP Arena Queue ticket schema and bounds
    function isValidArenaQueue(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.createdAt is timestamp
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000))
        && (!('roomCode' in data) || data.roomCode == null || (data.roomCode is string && data.roomCode.size() <= 30));
    }

    // ─── USER DATA ───────────────────────────────────────────────────
    match /users/{userId} {
      // Users can only READ their own profile (PII protection)
      allow read: if isOwner(userId);

      // CREATE: Only own document, prevent spoofing isAdmin, isPremium, or initial referral / duel counters
      allow create: if isOwner(userId)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false)
        && request.resource.data.get('totalExp', 0) <= 2000
        && request.resource.data.get('coins', 0) <= 250
        && request.resource.data.get('kidsCoins', 0) <= 250
        && request.resource.data.get('goldenKeys', 0) <= 1
        && request.resource.data.get('keys', 0) <= 1
        && request.resource.data.get('hasClaimedReferral', false) == false
        && request.resource.data.get('totalReferralsCount', 0) == 0
        && request.resource.data.get('monthlyReferralsCount', 0) == 0
        && request.resource.data.get('dailyDuelsPlayedToday', 0) == 0
        && request.resource.data.get('duelWins', 0) == 0
        && request.resource.data.get('duelLosses', 0) == 0
        && (!('pendingReferralCode' in request.resource.data) || request.resource.data.pendingReferralCode == null || (request.resource.data.pendingReferralCode is string && request.resource.data.pendingReferralCode.size() <= 30));

      // UPDATE: Only own document with robust anti-cheat & rate-limit guards.
      // Defensively guards against resource == null (merge writes creating documents)
      // and missing map properties to eliminate runtime CEL exceptions (PERMISSION_DENIED).
      allow update: if isOwner(userId)
        && (
          resource == null
            // Fresh document creation via merge-write (e.g., SetOptions(merge: true))
            ? (
                (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
                && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false)
                && request.resource.data.get('totalExp', 0) <= 2000
                && request.resource.data.get('coins', 0) <= 250
                && request.resource.data.get('kidsCoins', 0) <= 250
                && request.resource.data.get('goldenKeys', 0) <= 1
                && request.resource.data.get('keys', 0) <= 1
                && request.resource.data.get('hasClaimedReferral', false) == false
                && request.resource.data.get('totalReferralsCount', 0) == 0
                && request.resource.data.get('monthlyReferralsCount', 0) == 0
                && request.resource.data.get('dailyDuelsPlayedToday', 0) == 0
                && request.resource.data.get('duelWins', 0) == 0
                && request.resource.data.get('duelLosses', 0) == 0
                && (!('pendingReferralCode' in request.resource.data) || request.resource.data.pendingReferralCode == null || (request.resource.data.pendingReferralCode is string && request.resource.data.pendingReferralCode.size() <= 30))
              )
            // Existing document update
            : (
                // CRITICAL: Prevent users from escalating to admin privileges.
                // Admins can update isAdmin, and setting/keeping isAdmin: false is permitted (e.g. initial profile provisioning).
                (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin'])
                  || (isAdmin() || request.resource.data.get('isAdmin', false) == false))
                // CRITICAL: Prevent users from arbitrarily making themselves premium.
                // Allowed if:
                // a) isAdmin(), OR
                // b) Client-side reset/revocation (isPremium == false), OR
                // c) Legitimate in-app reward claim (Referral trial, Weekly reward, Ambassador Cup, Ambassador Referral Reward)
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'premiumExpiryDate'])
                  || isAdmin()
                  || request.resource.data.get('isPremium', false) == false
                  || isLegitimatePremiumRewardClaim()
                )
                // Sanity checks for progression (prevent jumping to 1M XP instantly)
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalExp'])
                  || (
                    request.resource.data.get('totalExp', 0) <= resource.data.get('totalExp', 0) + 2000 
                    && request.resource.data.get('totalExp', 0) >= resource.data.get('totalExp', 0)
                  )
                )
                // MONEY SECURITY: Prevent adding huge amounts of coins from the client
                // Normal game rewards are 10-50. Staking duels award +50 (win) or +10 (consolation). Entry fee subtracts 30.
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins'])
                  || (
                    request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimedLevelMilestones', 'claimedStreakMilestones', 'claimedAmbassadorRewardMonthKeys', 'claimedWeeklyRewardWeekKeys', 'totalReferralsCount'])
                      ? request.resource.data.get('coins', 0) <= resource.data.get('coins', 0) + 15000 // Milestone, ambassador sync, & tournament rewards can be larger
                      : request.resource.data.get('coins', 0) <= resource.data.get('coins', 0) + 250 // Max 250 earned at once for normal games, referrals, and duels
                  )
                )
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kidsCoins'])
                  || (request.resource.data.get('kidsCoins', 0) <= resource.data.get('kidsCoins', 0) + 250) // Max 250 earned at once
                )
                // ANTI-SPAM: Enforce a strict 2-second rate limit on ANY rewards (XP or Coins)
                // This prevents hackers from bypassing the max-per-write limits by sending 100 writes/sec.
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalExp', 'coins', 'kidsCoins'])
                  || (
                    // Bypass rate limit if it's a purchase/entry-fee/penalty (values are decreasing or staying the same)
                    (
                      request.resource.data.get('totalExp', 0) <= resource.data.get('totalExp', 0) &&
                      request.resource.data.get('coins', 0) <= resource.data.get('coins', 0) &&
                      request.resource.data.get('kidsCoins', 0) <= resource.data.get('kidsCoins', 0)
                    )
                    // Bypass rate limit for milestone & tournament claims (already protected by counter/array checks)
                    || request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimedLevelMilestones', 'claimedStreakMilestones', 'claimedAmbassadorRewardMonthKeys', 'claimedWeeklyRewardWeekKeys', 'totalReferralsCount'])
                    // If they increased normally, enforce the timestamp cooldown with robust type checking
                    || (
                      ('lastRewardTimestamp' in request.resource.data) &&
                      request.resource.data.lastRewardTimestamp == request.time &&
                      (
                        !('lastRewardTimestamp' in resource.data) || 
                        resource.data.lastRewardTimestamp == null ||
                        !(resource.data.lastRewardTimestamp is timestamp) ||
                        request.time >= resource.data.lastRewardTimestamp + duration.value(2, 's')
                      )
                    )
                  )
                )
                // KEY SECURITY: Prevent granting oneself infinite keys (protects both 'goldenKeys' and 'keys')
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['goldenKeys', 'keys'])
                  || (
                    request.resource.data.get('goldenKeys', 0) <= resource.data.get('goldenKeys', 0) + 1
                    && request.resource.data.get('keys', 0) <= resource.data.get('keys', 0) + 1
                  )
                )
                // 1v1 DUEL STATS INTEGRITY: Prevent jumping duel statistics
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['duelWins'])
                  || request.resource.data.get('duelWins', 0) <= resource.data.get('duelWins', 0) + 1
                )
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['duelLosses'])
                  || request.resource.data.get('duelLosses', 0) <= resource.data.get('duelLosses', 0) + 1
                )
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyDuelsPlayedToday'])
                  || request.resource.data.get('dailyDuelsPlayedToday', 0) <= resource.data.get('dailyDuelsPlayedToday', 0) + 1
                  || request.resource.data.get('dailyDuelsPlayedToday', 0) == 0
                )
                // IMMUTABILITY: Prevent modifying referral identities once set
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referralCode'])
                  || !('referralCode' in resource.data) || resource.data.referralCode == null || resource.data.referralCode == ''
                  || request.resource.data.referralCode == resource.data.referralCode
                )
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referredBy'])
                  || !('referredBy' in resource.data) || resource.data.referredBy == null || resource.data.referredBy == ''
                  || request.resource.data.referredBy == resource.data.referredBy
                )
                // REFERRAL INTEGRITY: Validate pending referral code format (null or string <= 30 chars)
                && (
                  !('pendingReferralCode' in request.resource.data)
                  || request.resource.data.pendingReferralCode == null
                  || (request.resource.data.pendingReferralCode is string && request.resource.data.pendingReferralCode.size() <= 30)
                )
                // REFERRAL INTEGRITY: Prevent resetting referral onboarding bonus flag once claimed
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hasClaimedReferral'])
                  || resource.data.get('hasClaimedReferral', false) != true
                  || request.resource.data.get('hasClaimedReferral', false) == true
                )
                && (
                  !('hasClaimedReferral' in request.resource.data)
                  || request.resource.data.hasClaimedReferral is bool
                )
                // REFERRAL INTEGRITY: Prevent decreasing total referral count
                && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalReferralsCount'])
                  || request.resource.data.get('totalReferralsCount', 0) >= resource.data.get('totalReferralsCount', 0)
                )
              )
        );

      // DELETE: Only own document
      allow delete: if isOwner(userId);
      
      // ERROR JOURNAL: Allow users to log and clear their wrong answers
      match /errorJournal/{errorId} {
        // Users can read and dismiss (delete) their own logs
        allow read, delete: if isOwner(userId);
        
        // Strict create and update rules to prevent spamming huge payloads
        // Update is necessary for deduplication (bumping timestamp on existing mistakes)
        allow create, update: if isOwner(userId)
          // FIELD WHITELIST: Prevents injecting arbitrary junk fields to inflate document size
          && request.resource.data.keys().hasOnly(['gameType', 'question', 'userAnswer', 'correctAnswer', 'level', 'timestamp', 'options'])
          // MAXIMUM payload length for strings and lists (Prevents storage DoS)
          && (!('gameType' in request.resource.data) || (request.resource.data.gameType is string && request.resource.data.gameType.size() < 100))
          && (!('question' in request.resource.data) || (request.resource.data.question is string && request.resource.data.question.size() < 1000))
          && (!('userAnswer' in request.resource.data) || (request.resource.data.userAnswer is string && request.resource.data.userAnswer.size() < 1000))
          && (!('correctAnswer' in request.resource.data) || (request.resource.data.correctAnswer is string && request.resource.data.correctAnswer.size() < 1000))
          && (!('options' in request.resource.data) || (request.resource.data.options is list && request.resource.data.options.size() < 20))
          // Ensures the timestamp is a true server-side timestamp
          && request.resource.data.timestamp == request.time;
      }
    }

    // ─── VIRAL REFERRAL ENGINE & AMBASSADOR CUP ───────────────────────
    match /referrals/{referralCode} {
      // Authenticated users can look up referral codes and query leaderboards
      allow read: if isAuthenticated();

      // Only authenticated users can register their own unique referral code
      allow create: if isAuthenticated()
        && referralCode.size() >= 6 && referralCode.size() <= 16
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.code == referralCode
        && request.resource.data.createdAt == request.time
        && request.resource.data.successfulCount == 0
        && request.resource.data.monthlyCount == 0
        && isValidReferralData(request.resource.data);

      // Updates are strictly governed:
      // A. Owner can update metadata (name, photo, or rollover month) but CANNOT inflate successfulCount
      // B. An invited friend can atomically increment successfulCount and monthlyCount by exactly 1 upon completing Level 1
      allow update: if isAuthenticated()
        && isValidReferralData(request.resource.data)
        && request.resource.data.code == resource.data.code
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // Case A: Owner update
          (
            request.auth.uid == resource.data.ownerId
            && request.resource.data.successfulCount == resource.data.successfulCount
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['monthlyCount'])
              || request.resource.data.monthlyCount == resource.data.monthlyCount
              || request.resource.data.monthlyCount == 0
            )
          )
          // Case B: Invited friend completing Level 1
          || (
            request.auth.uid != resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['successfulCount', 'monthlyCount', 'currentMonthKey', 'lastReferralTimestamp'])
            && request.resource.data.get('ownerName', '') == resource.data.get('ownerName', '')
            && request.resource.data.get('ownerPhotoUrl', null) == resource.data.get('ownerPhotoUrl', null)
            && request.resource.data.successfulCount == resource.data.get('successfulCount', 0) + 1
            && (
              request.resource.data.monthlyCount == resource.data.get('monthlyCount', 0) + 1
              || request.resource.data.monthlyCount == 1
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReferralTimestamp'])
              || request.resource.data.lastReferralTimestamp == request.time
            )
          )
        );

      // Deletion is strictly prohibited to preserve ambassador history and link integrity
      allow delete: if false;
    }

    // ─── 1v1 PVP STAKING ARENA ───────────────────────────────────────
    match /arena_rooms/{roomCode} {
      // Authenticated users can list/read rooms to discover lobbies and observe duel progress
      allow read: if isAuthenticated();

      // Host creates an open lobby room OR matched guest creates duel room with a queued host
      allow create: if isAuthenticated()
        && roomCode.size() >= 6 && roomCode.size() <= 20
        && request.resource.data.stake == 30
        && request.resource.data.createdAt == request.time
        && isValidArenaRoom(request.resource.data)
        && (
          // Case 1: Host creating an open lobby room
          (
            request.resource.data.hostId == request.auth.uid
            && (!('guestId' in request.resource.data) || request.resource.data.guestId == null)
          )
          // Case 2: Guest matched with a queued host, creating the room
          || (
            request.resource.data.guestId == request.auth.uid
            && request.resource.data.hostId != request.auth.uid
          )
        );

      // Host, joined guest, or new guest joining an open room can update game state
      allow update: if isAuthenticated()
        && (
          request.auth.uid == resource.data.hostId
          || request.auth.uid == resource.data.get('guestId', '')
          || (resource.data.get('guestId', null) == null && request.resource.data.guestId == request.auth.uid)
        )
        // Immutable room parameters
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.stake == 30
        && request.resource.data.createdAt == resource.data.createdAt
        // Once guestId is set, prevent hijacking by a third player
        && (
          resource.data.get('guestId', null) == null
          || request.resource.data.get('guestId', null) == resource.data.guestId
        )
        && isValidArenaRoom(request.resource.data);

      // Only host can cancel / dissolve an arena room
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.hostId;
    }

    // ─── 1v1 PVP MATCHMAKING QUEUE ────────────────────────────────────
    match /arena_queue/{queueId} {
      // Authenticated players can query the queue to discover opponents
      allow read: if isAuthenticated();

      // Players can enter the queue with their own auth UID and server timestamp
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isValidArenaQueue(request.resource.data);

      // Queue entries are ephemeral tickets: updates are disallowed
      allow update: if false;

      // Authenticated players can delete: either the queue entry owner canceling/leaving,
      // or another authenticated player popping/matching them into an arena duel
      allow delete: if isAuthenticated();
    }

    // ─── GLOBAL METADATA ─────────────────────────────────────────────
    match /metadata/leaderboard_cache {
      // Allow all users to read pre-calculated rankings
      allow read: if isAuthenticated();
      // SECURITY: Only Cloud Functions (admin SDK) can write leaderboard data
      allow write: if false;
    }

    match /metadata/kids_leaderboard_cache {
      // Allow all users to read pre-calculated kids rankings
      allow read: if isAuthenticated();
      // SECURITY: Only Cloud Functions (admin SDK) can write leaderboard data
      allow write: if false;
    }

    // ─── RATE LIMITING (Server-Side Only) ─────────────────────────────
    match /rate_limits/{document=**} {
      allow read, write: if false;
    }

    // ─── CURRICULUM & QUEST DATA ─────────────────────────────────────
    match /coinPacks/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /speaking_quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /reading_quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /grammar_quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /kids_quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /curriculum/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /vocabulary_quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /roleplay_quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /listening_quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /accent_quests/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── SUBSCRIPTION PLANS ──────────────────────────────────
    match /subscriptionPlans/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── ORDERS (server-created, client-readable) ───────────
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.get('userId', '') == request.auth.uid;
      allow write: if false; // Server-only via admin SDK
    }

    // ─── DEFAULT DENY ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
