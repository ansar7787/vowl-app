rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile Pictures
    match /profile_pics/{imageId} {
      // Anyone authenticated can read user profile pictures (for rankings / socials)
      allow read: if request.auth != null;
      
      // Users can only upload or update their own profile picture (< 5MB, valid image MIME type)
      allow create, update: if request.auth != null 
                   && (imageId == request.auth.uid || imageId == request.auth.uid + '.jpg')
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');

      // Users can only delete their own profile picture
      allow delete: if request.auth != null 
                   && (imageId == request.auth.uid || imageId == request.auth.uid + '.jpg');
    }
    
    // Fallback block - All other paths are strictly locked down
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

