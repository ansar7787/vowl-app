# Enforce UTF-8 and LF line endings across the repository
* text=auto eol=lf
*.dart text eol=lf diff=dart
*.json text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.arb text eol=lf
*.txt text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.mp4 binary

